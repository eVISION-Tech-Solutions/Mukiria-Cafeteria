NODE_ENV=development
PORT=8000
TRUST_PROXY=false

# Supabase > Project Settings > API. Never expose the service role key to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated exact browser origins. Include your production frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_15_MINUTES=10

# Safaricom Daraja. Use an externally reachable HTTPS callback in production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-api-domain.com/api/payments/callback/
